#!/usr/bin/env bash
# ai-profile — switch the agent profile of a project (Claude Code and Cursor).
#
# A profile is a folder under .ai/ with its own plugins and prompt:
#
#   .ai/common/   ai-plugin.json, ai-plugin.lock.json     plugins every profile gets (optional)
#   .ai/builder/  prompt.md, ai-plugin.json, ai-plugin.lock.json
#   .ai/tester/   prompt.md, ai-plugin.json, ai-plugin.lock.json
#   .ai/current → builder                                 written by `ai-profile enable`
#
# `enable <name>` merges common + <name> into the root ai-plugin.json and lock,
# then runs `deck install --frozen`: deck removes the previous profile's plugins,
# installs the new ones, and skips the ones both share. The prompt is not
# copied: CLAUDE.md imports @.ai/current/prompt.md, and Cursor gets
# .cursor/rules/ai-profile.mdc.
#
# Edit a profile with deck itself, inside its folder:
#   deck -C .ai/builder add owner/repo@plugin
#
# Usage:
#   ai-profile new <name>       create .ai/<name>/ (prompt.md, ai-plugin.json with hosts off)
#   ai-profile enable <name>    activate a profile
#   ai-profile off              deactivate (remove every profile plugin)
#   ai-profile current          print the active profile
#   ai-profile list             list profiles
#
# Options: -C <dir> project root (default: git top level, else cwd).
# Environment: DECK=<command> to run deck (default: `deck` on PATH, else `npx -y @pinkpuma/deck`).

set -euo pipefail

die() { echo "ai-profile: $*" >&2; exit 1; }

root=""
if [[ "${1:-}" == "-C" ]]; then
  [[ -n "${2:-}" ]] || die "-C needs a directory"
  root="$(cd "$2" && pwd)"
  shift 2
fi
if [[ -z "$root" ]]; then
  root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
fi
ai="$root/.ai"
cmd="${1:-}"
name="${2:-}"

if [[ -n "${DECK:-}" ]]; then
  read -r -a deck <<<"$DECK"
elif command -v deck >/dev/null 2>&1; then
  deck=(deck)
else
  deck=(npx -y @pinkpuma/deck)
fi

IMPORT_LINE="@.ai/current/prompt.md"
CURSOR_RULE=".cursor/rules/ai-profile.mdc"

profiles() {
  [[ -d "$ai" ]] || return 0
  for dir in "$ai"/*/; do
    local base
    base="$(basename "$dir")"
    [[ "$base" == "common" || "$base" == "current" ]] && continue
    [[ -f "$dir/ai-plugin.json" ]] && echo "$base"
  done
}

current() {
  [[ -L "$ai/current" ]] && basename "$(readlink "$ai/current")" || true
}

# Merge the request and lock of each given profile folder into the root files.
# Fails on an id two folders both request, and on a folder whose lock is missing.
write_root() {
  node - "$root" "$@" <<'JS'
const fs = require("node:fs");
const path = require("node:path");
const [root, ...dirs] = process.argv.slice(2);
const read = (file) => JSON.parse(fs.readFileSync(file, "utf8"));
const plugins = [];
const locked = [];
const owner = new Map();
for (const dir of dirs) {
  const reqFile = path.join(dir, "ai-plugin.json");
  if (!fs.existsSync(reqFile)) continue;
  const request = read(reqFile).plugins ?? [];
  if (request.length === 0) continue;
  const lockFile = path.join(dir, "ai-plugin.lock.json");
  const rel = path.relative(root, dir);
  if (!fs.existsSync(lockFile)) {
    console.error(`ai-profile: ${rel} has no ai-plugin.lock.json. Run: deck -C ${rel} install`);
    process.exit(1);
  }
  const lock = read(lockFile);
  for (const entry of request) {
    if (owner.has(entry.id)) {
      console.error(`ai-profile: "${entry.id}" is requested by both ${owner.get(entry.id)} and ${rel}`);
      process.exit(1);
    }
    owner.set(entry.id, rel);
    plugins.push(entry);
    const pin = (lock.plugins ?? []).find((p) => p.id === entry.id);
    if (pin) locked.push(pin);
  }
}
const write = (file, value) => fs.writeFileSync(path.join(root, file), `${JSON.stringify(value, null, 2)}\n`);
write("ai-plugin.json", { plugins });
write("ai-plugin.lock.json", { lockfileVersion: 3, writeAgentsMd: true, plugins: locked });
JS
}

# The root ai-plugin.json and lock are generated: keep them out of git.
ensure_gitignore() {
  local file="$root/.gitignore" header="# ai-profile — generated by ai-profile enable"
  [[ -f "$file" ]] || : >"$file"
  grep -qxF "$header" "$file" && return 0
  [[ -s "$file" ]] && printf '\n' >>"$file"
  printf '%s\n/ai-plugin.json\n/ai-plugin.lock.json\n.ai/current\n%s\n' "$header" "$CURSOR_RULE" >>"$file"
}

ensure_claude_import() {
  local file="$root/CLAUDE.md"
  if [[ -f "$file" ]] && grep -qxF "$IMPORT_LINE" "$file"; then return 0; fi
  [[ -f "$file" ]] && [[ -s "$file" ]] && printf '\n' >>"$file"
  printf '%s\n' "$IMPORT_LINE" >>"$file"
}

drop_claude_import() {
  local file="$root/CLAUDE.md"
  [[ -f "$file" ]] || return 0
  grep -vxF "$IMPORT_LINE" "$file" >"$file.ai-profile.tmp" || true
  mv "$file.ai-profile.tmp" "$file"
}

write_cursor_rule() {
  local prompt="$ai/$1/prompt.md" rule="$root/$CURSOR_RULE"
  if [[ ! -f "$prompt" ]]; then
    rm -f "$rule"
    return 0
  fi
  mkdir -p "$(dirname "$rule")"
  {
    printf -- '---\ndescription: Active agent profile (%s), written by ai-profile\nalwaysApply: true\n---\n\n' "$1"
    cat "$prompt"
  } >"$rule"
}

install() {
  "${deck[@]}" install --frozen --project "$root"
}

case "$cmd" in
  list)
    active="$(current)"
    while read -r p; do
      [[ -n "$p" ]] || continue
      [[ "$p" == "$active" ]] && echo "* $p" || echo "  $p"
    done < <(profiles)
    ;;

  current)
    active="$(current)"
    echo "${active:-(none)}"
    ;;

  new)
    [[ -n "$name" ]] || die "new needs a profile name"
    [[ "$name" =~ ^[A-Za-z0-9._-]+$ && "$name" != "current" ]] || die "invalid profile name: $name"
    [[ -e "$ai/$name" ]] && die ".ai/$name already exists"
    mkdir -p "$ai/$name"
    printf '# %s\n\nYou are the %s agent of this project.\n' "$name" "$name" >"$ai/$name/prompt.md"
    printf '{\n  "plugins": [],\n  "hosts": { "claude": "off", "cursor": "off" }\n}\n' >"$ai/$name/ai-plugin.json"
    echo "Created .ai/$name. Add plugins with: deck -C .ai/$name add <source>"
    ;;

  enable)
    [[ -n "$name" ]] || die "enable needs a profile name ($(profiles | tr '\n' ' '))"
    [[ -f "$ai/$name/ai-plugin.json" ]] || die "no profile .ai/$name (with an ai-plugin.json)"
    write_root "$ai/common" "$ai/$name"
    ln -sfn "$name" "$ai/current"
    ensure_gitignore
    ensure_claude_import
    write_cursor_rule "$name"
    install
    echo "Profile $name enabled. Start a new Claude session (or /reload-plugins) and reload the Cursor window."
    ;;

  off)
    write_root
    rm -f "$ai/current" "$root/$CURSOR_RULE"
    drop_claude_import
    install
    echo "No profile enabled."
    ;;

  *)
    sed -n '2,32p' "$0" | sed 's/^# \{0,1\}//'
    [[ -z "$cmd" || "$cmd" == "-h" || "$cmd" == "--help" ]] || exit 1
    ;;
esac
